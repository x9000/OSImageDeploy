<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UserSecretsId>c79ce1e4-decc-4d27-857b-8c950c011231</UserSecretsId>
		<PlatformTarget>x64</PlatformTarget>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>OSImageDeploy.ico</ApplicationIcon>
		<SignAssembly>False</SignAssembly>
		<DelaySign>False</DelaySign>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="OSImageDeploy.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MVVMLibrary\MVVMLibrary.csproj" />
		<ProjectReference Include="..\Utilities\Utilities.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="DellPEDrivers.zip">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="HPPEDrivers.zip">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

	<PropertyGroup>
		<ProjectStartDate>2026-05-23</ProjectStartDate>
	</PropertyGroup>

	<Target Name="CalculateBuildVersion" BeforeTargets="GetAssemblyVersion">
		<PropertyGroup>
			<BuildNumber>$([System.DateTime]::Now.Subtract($([System.DateTime]::Parse('$(ProjectStartDate)'))).Days)</BuildNumber>
			<RevisionNumber>$([System.DateTime]::Now.Hour)$([System.DateTime]::Now.Minute)</RevisionNumber>
			<Version>1.0.$(BuildNumber).$(RevisionNumber)</Version>
			<AssemblyVersion>1.0.$(BuildNumber).$(RevisionNumber)</AssemblyVersion>
			<FileVersion>1.0.$(BuildNumber).$(RevisionNumber)</FileVersion>
			<InformationalVersion>1.0.$(BuildNumber).$(RevisionNumber)</InformationalVersion>
		</PropertyGroup>

		<Message Text="Calculated build version: $(Version)" Importance="High" />
	</Target>

	<PropertyGroup>
		<CodeSigningCertificateThumbprint>F2E897E8C120F3D58CB8E8BF99F1FE56E36FC907</CodeSigningCertificateThumbprint>
		<SigningScriptPath>$(MSBuildThisFileDirectory)..\Build\Sign-File.ps1</SigningScriptPath>
		<EnableCodeSigning Condition="'$(EnableCodeSigning)' == ''">true</EnableCodeSigning>
	</PropertyGroup>

	<Target Name="SignBuildOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(EnableCodeSigning)' == 'true'">

		<ItemGroup>
			<FilesToSign Include="$(TargetPath)" />

			<FilesToSign Include="$(TargetDir)$(AssemblyName).exe" Condition="Exists('$(TargetDir)$(AssemblyName).exe')" />

			<FilesToSign Include="$(TargetDir)MVVMLibrary.dll" Condition="Exists('$(TargetDir)MVVMLibrary.dll')" />

			<FilesToSign Include="$(TargetDir)OSImageDeploy.dll" Condition="Exists('$(TargetDir)OSImageDeploy.dll')" />
			
			<FilesToSign Include="$(TargetDir)Utilities.dll" Condition="Exists('$(TargetDir)Utilities.dll')" />
		</ItemGroup>

		<Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SigningScriptPath)&quot; -FilePath &quot;%(FilesToSign.FullPath)&quot; -CertificateThumbprint &quot;$(CodeSigningCertificateThumbprint)&quot;" />

	</Target>

	<Target Name="SignPublishOutput" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(EnableCodeSigning)' == 'true'">

		<ItemGroup>
			<PublishedFilesToSign Include="$(PublishDir)$(AssemblyName).dll" Condition="Exists('$(PublishDir)$(AssemblyName).dll')" />

			<PublishedFilesToSign Include="$(PublishDir)$(AssemblyName).exe" Condition="Exists('$(PublishDir)$(AssemblyName).exe')" />
		</ItemGroup>

		<Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SigningScriptPath)&quot; -FilePath &quot;%(PublishedFilesToSign.FullPath)&quot; -CertificateThumbprint &quot;$(CodeSigningCertificateThumbprint)&quot;" />

	</Target>

</Project>
