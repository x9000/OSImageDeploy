<Window x:Class="OSImageDeploy.Views.MainUSBCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ViewModels="clr-namespace:ViewModels"
        mc:Ignorable="d"
        Title="{Binding TitleTextBlockText}"
        Height="820"
        Width="1220"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F7FB"
        Foreground="#FF172B4D"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.DataContext>
        <ViewModels:MainUSBCreatorWindowViewModel x:Name="MainUSBCreatorVM"/>
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF175CD3"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF1849A9"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FFD92D20"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFB42318"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF526581"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FFD8E0EB"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF172B4D"/>
        </Style>

        <Style x:Key="HelpTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FF175CD3"/>
            <Setter Property="Background" Value="#FFEFF4FF"/>
            <Setter Property="BorderBrush" Value="#FFB2CCFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFD1E0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FF172B4D"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFB8C4D6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FF172B4D"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF172B4D"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF102A43" Padding="30,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding TitleTextBlockText}"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Build trusted Windows deployment media"
                               Foreground="#FFB9C9DA"
                               FontSize="14"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#FF173F61"
                        CornerRadius="16"
                        Padding="14,7"
                        VerticalAlignment="Center">
                    <TextBlock Text="LOCAL WINDOWS SERVICE"
                               Foreground="#FFD5E7F7"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,22,26,18">
            <Grid Visibility="{Binding MainStackPanelVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="1. Select the target device" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Only USB devices accepted by the service safety checks are shown. The selected disk is rediscovered and revalidated before erasure."
                                       Style="{StaticResource HelpTextStyle}" Margin="0,6,0,16"/>
                            <ComboBox x:Name="USBListComboBox"
                                      ItemsSource="{Binding ListOfUSBDrives}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedIndex="{Binding USBComboxSelectedItemIndex}"/>
                            <Button x:Name="RefreshUSBButton"
                                    Content="Refresh device list"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,12,0,0"
                                    Command="{Binding RefreshUSBButtonCommand, Mode=OneWay}"
                                    IsEnabled="{Binding RefreshUSBButtonEnabled}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="2. Create deployment media" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Creation is destructive. You will see the exact physical disk and selected driver packages again before anything is erased."
                                       Style="{StaticResource HelpTextStyle}" Margin="0,6,0,16"/>
                            <Button x:Name="CreateUSBButton"
                                    Style="{StaticResource DangerButtonStyle}"
                                    IsEnabled="{Binding CreateUSBButtonEnabled}"
                                    Command="{Binding CreateUSBCommand, Mode=OneWay}"
                                    CommandParameter="{Binding SelectedItem, ElementName=USBListComboBox}">
                                <StackPanel>
                                    <TextBlock Text="Create bootable USB" TextAlignment="Center"/>
                                    <TextBlock Text="Erases the selected disk" FontSize="11" FontWeight="Normal" TextAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="0" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="WinPE media cache" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding WinPeCacheStatusText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding WinPeCacheDetailsText}" Style="{StaticResource HelpTextStyle}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Rebuild cache"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RebuildWinPeCacheCommand, Mode=OneWay}"
                                    IsEnabled="{Binding RebuildWinPeCacheButtonEnabled}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Optional manufacturer WinPE drivers" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding WinPeDriverPackagesStatusText}"
                                       Style="{StaticResource HelpTextStyle}"
                                       Margin="0,6,0,10"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding WinPeDriverPackages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="2,13">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <CheckBox Content="{Binding Package.DisplayName}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding Package.IsAvailable}"
                                                                  FontWeight="SemiBold"
                                                                  FontSize="15"/>
                                                        <TextBlock Text="{Binding Package.StatusMessage}"
                                                                   Style="{StaticResource HelpTextStyle}"
                                                                   Margin="24,4,16,0"/>
                                                        <TextBlock Text="{Binding Package.PreparationInstructions}"
                                                                   Style="{StaticResource HelpTextStyle}"
                                                                   FontSize="12"
                                                                   Margin="24,4,16,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Margin="8,2,0,0">
                                                        <Hyperlink NavigateUri="{Binding Package.SourcePageUrl}"
                                                                   RequestNavigate="OpenExternalLink"
                                                                   Foreground="#FF175CD3">Official guidance</Hyperlink>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource CardStyle}"
                        Margin="0,18,0,0"
                        Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Operation status" FontWeight="SemiBold" Foreground="#FF172B4D"/>
                            <TextBlock Text="{Binding InfoTextBlockText}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FF344563"/>
                            <TextBlock Text="{Binding SubInfoTextBlockText}" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                            <ProgressBar Height="8"
                                         Margin="0,12,0,0"
                                         Maximum="100"
                                         Value="{Binding OperationProgressValue}"
                                         Visibility="{Binding OperationProgressVisibility}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Cancel operation"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="20,0,0,0"
                                Command="{Binding CancelUSBCommand, Mode=OneWay}"
                                IsEnabled="{Binding CancelUSBButtonEnabled}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Visibility="{Binding PrereqStackPanelVisibility}"
                    Style="{StaticResource CardStyle}"
                    Width="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Windows deployment prerequisites" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Install the required Microsoft deployment components before creating USB media."
                               Style="{StaticResource HelpTextStyle}" Margin="0,6,0,16"/>
                    <ItemsControl ItemsSource="{Binding PreReqChecks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Text}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="False"
                                          Margin="0,5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Install requirements"
                            Margin="0,18,0,0"
                            IsEnabled="{Binding PreReqInstallButtonEnabled}"
                            Command="{Binding StartPrereqInstalls, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#FFD8E0EB"
                BorderThickness="0,1,0,0"
                Padding="26,12">
            <Grid>
                <TextBlock Text="© 2026 x9000.com Consulting Services Limited"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="Exit"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="24,8"
                        HorizontalAlignment="Right"
                        Command="{Binding ExitCommand, Mode=OneWay}"
                        IsEnabled="{Binding ExitButtonEnabled}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
