<Window x:Class="OSImageDeploy.Views.MainUSBCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ViewModels="clr-namespace:ViewModels"
        mc:Ignorable="d"
        Title="MainUSBCreatorWindow" Height="600" Width="1000" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="Transparent" Foreground="White" FontFamily="Arial" FontSize="20" AllowsTransparency="True">
    <Window.DataContext>
        <ViewModels:MainUSBCreatorWindowViewModel x:Name="MainUSBCreatorVM"/>
    </Window.DataContext>
    <Window.Resources>
        <!-- Modern Button -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FF2D8CFF"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="340">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF4DA3FF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF1A63B7"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="DarkSlateGray"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="25">
        <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFD22C2C" Offset="1"/>
                <GradientStop Color="#FF1E1BE7"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,20,0,0">
                <TextBlock Text="{Binding TitleTextBlockText}" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="1" Width="600">
                <StackPanel Visibility="{Binding MainStackPanelVisibility}">
                    <ComboBox x:Name="USBListComboBox" ItemsSource="{Binding ListOfUSBDrives}" Margin="0,0,0,10" SelectedIndex="{Binding USBComboxSelectedItemIndex}" Width="420"/>
                    <Button x:Name="CreateUSBButton" Margin="0,5,0,5" IsEnabled="{Binding CreateUSBButtonEnabled}" Command="{Binding CreateUSBCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem.DiskNumber, ElementName=USBListComboBox}">
                        <StackPanel>
                            <TextBlock TextAlignment="Center">
                        Create a bootable USB
                            </TextBlock>
                            <TextBlock TextAlignment="Center">
                        (Warning Destructive)
                            </TextBlock>
                        </StackPanel>

                    </Button>
                    <Button x:Name="RefreshUSBButton" Margin="0,5,0,5" Command="{Binding RefreshUSBButtonCommand, Mode=OneWay}" IsEnabled="{Binding RefreshUSBButtonEnabled}">
                        Refresh USB List
                    </Button>
                    <Border Background="#26000000"
                            BorderBrush="#60FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,10,0,5"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding WinPeCacheStatusText}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding WinPeCacheDetailsText}"
                                       FontSize="13"
                                       Margin="0,4,0,8"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Content="Rebuild WinPE Cache"
                                    Command="{Binding RebuildWinPeCacheCommand, Mode=OneWay}"
                                    IsEnabled="{Binding RebuildWinPeCacheButtonEnabled}"
                                    FontSize="14"
                                    Padding="10,6"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Visibility="{Binding PrereqStackPanelVisibility}">
                    <TextBlock Text="Requirements" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Border BorderBrush="Gray" BorderThickness="0" Margin="0,5,0,5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PreReqChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2" HorizontalContentAlignment="Center" Foreground="White" IsEnabled="False" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="InstallPrereqsButton" Content="Install Requirements" Margin="0,5,0,5" IsEnabled="{Binding PreReqInstallButtonEnabled}" Command="{Binding StartPrereqInstalls, Mode=OneWay}"/>
                </StackPanel>
                <Button x:Name="ExitButton" Margin="0,5,0,5" Command="{Binding ExitCommand, Mode=OneWay}" IsEnabled="{Binding ExitButtonEnabled}">
                    Exit
                </Button>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                <TextBlock Text="{Binding InfoTextBlockText}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{Binding SubInfoTextBlockText}" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="© 2026 x9000.com Consulting Services Limited" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="3" Margin="0,0,0,10"/>
        </Grid>
    </Border>
</Window>
