<Window x:Class="OSImageDeploy.Views.WinPeDriverPackagePreparationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prepare WinPE Driver Package"
        Width="700"
        Height="500"
        MinWidth="620"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Closing="WindowClosing"
        Background="#FFF4F7FB"
        FontFamily="Segoe UI"
        Foreground="#FF172B4D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#FF102A43" Padding="26,20">
            <StackPanel>
                <TextBlock Text="Prepare manufacturer WinPE drivers"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PackageNameTextBlock"
                           Foreground="#FFB9C9DA"
                           FontSize="14"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22">
                <TextBlock x:Name="ExplanationTextBlock"
                           TextWrapping="Wrap"
                           Foreground="#FF344563"/>

                <TextBlock Text="Manufacturer download"
                           FontWeight="SemiBold"
                           Margin="0,22,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourcePathTextBox"
                             IsReadOnly="True"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             BorderBrush="#FFB8C4D6"/>
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Content="Browse..."
                            Margin="10,0,0,0"
                            Padding="18,8"
                            Click="BrowseButtonClick"/>
                </Grid>

                <TextBlock Text="Package version (optional)"
                           FontWeight="SemiBold"
                           Margin="0,18,0,7"/>
                <TextBox x:Name="SourceVersionTextBox"
                         Padding="10,8"
                         BorderBrush="#FFB8C4D6"/>
                <TextBlock Text="Leave this blank to use version information from the download or its file name."
                           TextWrapping="Wrap"
                           Foreground="#FF5E6C84"
                           FontSize="12"
                           Margin="0,5,0,0"/>

                <Border Background="#FFEAF1FB"
                        BorderBrush="#FFC8D8ED"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="14"
                        Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="What the service will do"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="ServiceActionTextBlock"
                                   TextWrapping="Wrap"
                                   Foreground="#FF344563"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusTextBlock"
                           TextWrapping="Wrap"
                           Margin="0,20,0,0"/>
                <ProgressBar x:Name="PreparationProgressBar"
                             Height="8"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#FFD8E0EB"
                BorderThickness="0,1,0,0"
                Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Padding="20,8"
                        Margin="0,0,10,0"
                        Click="CancelButtonClick"/>
                <Button x:Name="PrepareButton"
                        Content="Prepare package"
                        Padding="20,8"
                        IsDefault="True"
                        Click="PrepareButtonClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
