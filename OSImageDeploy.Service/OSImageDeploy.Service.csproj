<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Exe</OutputType>
		<PlatformTarget>x64</PlatformTarget>
		<WinPeClientProject>$(MSBuildProjectDirectory)\..\OSImageDeployClient\OSImageDeployClient.csproj</WinPeClientProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OSImageDeploy.Contracts\OSImageDeploy.Contracts.csproj" />
		<ProjectReference Include="..\OSImageDeploy.Engine\OSImageDeploy.Engine.csproj" />
		<ProjectReference Include="..\OSImageDeploy.Platform.Windows\OSImageDeploy.Platform.Windows.csproj" />
		<ProjectReference Include="..\OSImageDeploy.Transport.Grpc\OSImageDeploy.Transport.Grpc.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\OSImageDeploy\DellPEDrivers.zip"
			Link="DellPEDrivers.zip"
			CopyToOutputDirectory="PreserveNewest"
			CopyToPublishDirectory="PreserveNewest" />
		<None Include="..\OSImageDeploy\HPPEDrivers.zip"
			Link="HPPEDrivers.zip"
			CopyToOutputDirectory="PreserveNewest"
			CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<PropertyGroup>
		<SigningScriptPath>$(MSBuildThisFileDirectory)..\Build\Sign-File.ps1</SigningScriptPath>
	</PropertyGroup>

	<Target Name="SignBuildOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(EnableCodeSigning)' == 'true'">
		<ItemGroup>
			<FilesToSign Include="$(TargetPath)" />
			<FilesToSign Include="$(TargetDir)$(AssemblyName).exe" Condition="Exists('$(TargetDir)$(AssemblyName).exe')" />
			<FilesToSign Include="$(TargetDir)OSImageDeploy.Contracts.dll" Condition="Exists('$(TargetDir)OSImageDeploy.Contracts.dll')" />
			<FilesToSign Include="$(TargetDir)OSImageDeploy.Engine.dll" Condition="Exists('$(TargetDir)OSImageDeploy.Engine.dll')" />
			<FilesToSign Include="$(TargetDir)OSImageDeploy.Platform.Windows.dll" Condition="Exists('$(TargetDir)OSImageDeploy.Platform.Windows.dll')" />
			<FilesToSign Include="$(TargetDir)OSImageDeploy.Transport.Grpc.dll" Condition="Exists('$(TargetDir)OSImageDeploy.Transport.Grpc.dll')" />
			<FilesToSign Include="$(TargetDir)Utilities.dll" Condition="Exists('$(TargetDir)Utilities.dll')" />
		</ItemGroup>

		<Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SigningScriptPath)&quot; -FilePath &quot;%(FilesToSign.FullPath)&quot; -CertificateThumbprint &quot;$(CodeSigningCertificateThumbprint)&quot;" />
	</Target>

	<Target Name="SignPublishOutput" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(EnableCodeSigning)' == 'true'">
		<ItemGroup>
			<PublishedFilesToSign Include="$(PublishDir)$(AssemblyName).dll" Condition="Exists('$(PublishDir)$(AssemblyName).dll')" />
			<PublishedFilesToSign Include="$(PublishDir)$(AssemblyName).exe" Condition="Exists('$(PublishDir)$(AssemblyName).exe')" />
			<PublishedFilesToSign Include="$(PublishDir)OSImageDeploy.Contracts.dll" Condition="Exists('$(PublishDir)OSImageDeploy.Contracts.dll')" />
			<PublishedFilesToSign Include="$(PublishDir)OSImageDeploy.Engine.dll" Condition="Exists('$(PublishDir)OSImageDeploy.Engine.dll')" />
			<PublishedFilesToSign Include="$(PublishDir)OSImageDeploy.Platform.Windows.dll" Condition="Exists('$(PublishDir)OSImageDeploy.Platform.Windows.dll')" />
			<PublishedFilesToSign Include="$(PublishDir)OSImageDeploy.Transport.Grpc.dll" Condition="Exists('$(PublishDir)OSImageDeploy.Transport.Grpc.dll')" />
			<PublishedFilesToSign Include="$(PublishDir)Utilities.dll" Condition="Exists('$(PublishDir)Utilities.dll')" />
		</ItemGroup>

		<Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SigningScriptPath)&quot; -FilePath &quot;%(PublishedFilesToSign.FullPath)&quot; -CertificateThumbprint &quot;$(CodeSigningCertificateThumbprint)&quot;" />
	</Target>

	<Target
		Name="PublishWinPeClientForDevelopment"
		AfterTargets="Build"
		Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">

		<RemoveDir Directories="$(TargetDir)WinPEClient" />

		<MSBuild
			Projects="$(WinPeClientProject)"
			Targets="Restore;Publish"
			Properties="Configuration=Release;PublishProfile=FolderProfile1;RuntimeIdentifier=win-x64;PublishDir=$(TargetDir)WinPEClient;EnableCodeSigning=false;BuildTimestampUtc=$(BuildTimestampUtc);BuildVersion=$(BuildVersion);BuildInformationalVersion=$(BuildInformationalVersion)" />
	</Target>

</Project>
