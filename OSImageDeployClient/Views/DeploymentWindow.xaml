<Window x:Class="OSImageDeployClient.Views.DeploymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OSImageDeployClient.Views"
        xmlns:ViewModels="clr-namespace:ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="OS Image Deploy Client"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#111827"
        FontFamily="Segoe UI" WindowStyle="None">
        <Window.DataContext>
               <ViewModels:DeploymentWindowViewModel x:Name="DeploymentVM"/>
        </Window.DataContext>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,8,0,20"/>
            <Setter Property="Foreground" Value="#22C55E"/>
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding WindowLoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Border Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth, ConverterParameter=0.82}"
                MaxWidth="1024"
                MinWidth="480"
                Margin="20"
                Padding="32"
                CornerRadius="18"
                Background="#F9FAFB"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,28">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="OS Image Deploy Client" FontSize="30" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="15" Foreground="#6B7280" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding MachineName}" DockPanel.Dock="Right" FontSize="14" Foreground="#6B7280" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                </DockPanel>
                <!-- Progress -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Overall Progress" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding OverallProgress}"/>
                    <DockPanel>
                        <TextBlock Text="Current Stage" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                        <TextBlock Text="{Binding CurrentStage}" DockPanel.Dock="Right" FontSize="14" Foreground="#2563EB" FontWeight="SemiBold" Margin="5,0,0,0"/>
                    </DockPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding StageProgress}"/>
                </StackPanel>
                <!-- Log / Details -->
                <Grid Grid.Row="2" Margin="0,8,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Deployment Log" FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="#111827" CornerRadius="10" Padding="14">
                        <Border Grid.Row="1" Background="#111827" CornerRadius="10" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="120">
                                <ItemsControl ItemsSource="{Binding LogItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="10" CornerRadius="6" Background="#1F2937" Visibility="{Binding Visibility}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Level}" FontWeight="SemiBold" Foreground="{Binding LevelBrush}" Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="#9CA3AF" FontFamily="Consolas"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </Grid>
                <!-- Footer Actions -->
                <DockPanel Grid.Row="3">
                    <TextBlock Text="{Binding ProgressText}" Foreground="#6B7280" FontSize="13" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Content="Command Line" Background="#4B5563" Command="{Binding CommandLineCommand, Mode=OneWay}"/>
                        <Button Content="Cancel" Background="#DC2626" Command="{Binding CancelCommand}"/>
                        <Button Content="{Binding StartButtonText}" Background="#16A34A" Command="{Binding StartRestoreCommand}" IsEnabled="{Binding RestoreEnabled}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>