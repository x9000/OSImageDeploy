<Window x:Class="OSImageDeployClient.Views.WimSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ViewModels="clr-namespace:ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Select Windows Image"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#111827"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <ViewModels:WimSelectionWindowViewModel x:Name="WimSelectionVM"/>
    </Window.DataContext>

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding WindowLoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="36">

        <Border Padding="28"
                CornerRadius="18"
                Background="#F9FAFB">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">

                    <TextBlock Text="Select Windows Image"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock Text="Choose the WIM file and the image index to apply to the Windows partition."
                               FontSize="14"
                               Foreground="#6B7280"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <!-- WIM Selection -->
                <Grid Grid.Row="1" Margin="0,0,0,20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Windows Image File"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" SelectedIndex="0"
                                  ItemsSource="{Binding AvailableWimFiles}"
                                  SelectedItem="{Binding SelectedWimFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Column="2"
                                 Text="{Binding SelectedWimFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"/>

                    </Grid>

                </Grid>

                <!-- Images -->
                <Grid Grid.Row="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,8">

                        <TextBlock Text="Available Images"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"/>

                        <TextBlock Text="{Binding ImageCountText}"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Right"
                                   DockPanel.Dock="Right"/>

                    </DockPanel>

                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10">

                        <DataGrid ItemsSource="{Binding Images}"
                                  SelectedItem="{Binding SelectedImage}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Background="White"
                                  BorderThickness="0"
                                  RowHeight="42"
                                  FontSize="13">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Index"
                                                    Binding="{Binding Index}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Description"
                                                    Binding="{Binding Description}"
                                                    Width="3*"/>

                                <DataGridTextColumn Header="Architecture"
                                                    Binding="{Binding Architecture}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Size"
                                                    Binding="{Binding DisplaySize}"
                                                    Width="120"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

                <!-- Status -->
                <Border Grid.Row="3"
                        Margin="0,18,0,18"
                        Padding="12"
                        CornerRadius="8"
                        Background="#EEF2FF">

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#3730A3"
                               TextWrapping="Wrap"/>

                </Border>

                <!-- Footer -->
                <DockPanel Grid.Row="4">

                    <TextBlock Text="{Binding SelectedImageSummary}"
                               Foreground="#6B7280"
                               FontSize="13"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right">

                        <Button Content="Cancel"
                                Background="#6B7280"
                                Command="{Binding CancelCommand, Mode=OneWay}"/>

                        <Button Content="Use Image"
                                Background="#16A34A"
                                Command="{Binding OkCommand, Mode=OneWay}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>