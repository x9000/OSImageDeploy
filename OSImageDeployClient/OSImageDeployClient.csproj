<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MVVMLibrary\MVVMLibrary.csproj" />
    <ProjectReference Include="..\Utilities\Utilities.csproj" />
  </ItemGroup>
	<PropertyGroup>
		<SigningScriptPath>$(MSBuildThisFileDirectory)..\Build\Sign-File.ps1</SigningScriptPath>
	</PropertyGroup>

	<Target Name="SignBuildOutput"
			AfterTargets="Build"
			Condition="'$(Configuration)' == 'Release' and '$(EnableCodeSigning)' == 'true'">

		<ItemGroup>
			<FilesToSign Include="$(TargetPath)" />

			<FilesToSign Include="$(TargetDir)$(AssemblyName).exe"
						 Condition="Exists('$(TargetDir)$(AssemblyName).exe')" />

			<FilesToSign Include="$(TargetDir)MVVMLibrary.dll"
						 Condition="Exists('$(TargetDir)MVVMLibrary.dll')" />

			<FilesToSign Include="$(TargetDir)OSImageDeployClient.dll"
						 Condition="Exists('$(TargetDir)OSImageDeployClient.dll')" />

			<FilesToSign Include="$(TargetDir)Utilities.dll"
						 Condition="Exists('$(TargetDir)Utilities.dll')" />
		</ItemGroup>

		<Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SigningScriptPath)&quot; -FilePath &quot;%(FilesToSign.FullPath)&quot; -CertificateThumbprint &quot;$(CodeSigningCertificateThumbprint)&quot;" />

	</Target>

	<Target Name="SignPublishOutput"
        AfterTargets="Publish"
        Condition="'$(Configuration)' == 'Release' and '$(EnableCodeSigning)' == 'true'">

		<ItemGroup>
			<PublishedFilesToSign Include="$(PublishDir)$(AssemblyName).dll"
								  Condition="Exists('$(PublishDir)$(AssemblyName).dll')" />

			<PublishedFilesToSign Include="$(PublishDir)$(AssemblyName).exe"
								  Condition="Exists('$(PublishDir)$(AssemblyName).exe')" />
		</ItemGroup>

		<Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SigningScriptPath)&quot; -FilePath &quot;%(PublishedFilesToSign.FullPath)&quot; -CertificateThumbprint &quot;$(CodeSigningCertificateThumbprint)&quot;" />

	</Target>
</Project>
