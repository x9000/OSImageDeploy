<Project Sdk="WixToolset.Sdk/7.0.0">

	<PropertyGroup>
		<OutputType>Package</OutputType>
		<OutputName>OSImageDeploySuite</OutputName>
		<InstallerPlatform>x64</InstallerPlatform>
		<AcceptEula>wix7</AcceptEula>

		<ProductVersion>$(BuildVersion)</ProductVersion>
		<DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion)</DefineConstants>

		<MainApplicationProject>$(MSBuildProjectDirectory)\..\OSImageDeploy\OSImageDeploy.csproj</MainApplicationProject>
		<ServiceProject>$(MSBuildProjectDirectory)\..\OSImageDeploy.Service\OSImageDeploy.Service.csproj</ServiceProject>
		<WinPeClientProject>$(MSBuildProjectDirectory)\..\OSImageDeployClient\OSImageDeployClient.csproj</WinPeClientProject>
		<MainPublishDirectory>$([System.IO.Path]::GetTempPath())OSImageDeploy.Installer\$(Configuration)\publish\Main</MainPublishDirectory>
		<ServicePublishDirectory>$([System.IO.Path]::GetTempPath())OSImageDeploy.Installer\$(Configuration)\publish\Service</ServicePublishDirectory>
		<WinPeClientPublishDirectory>$([System.IO.Path]::GetTempPath())OSImageDeploy.Installer\$(Configuration)\publish\WinPeClient</WinPeClientPublishDirectory>

		<CodeSigningCertificateThumbprint>F2E897E8C120F3D58CB8E8BF99F1FE56E36FC907</CodeSigningCertificateThumbprint>
		<EnableCodeSigning Condition="'$(EnableCodeSigning)' == '' and '$(Configuration)' == 'Release'">true</EnableCodeSigning>
		<EnableCodeSigning Condition="'$(EnableCodeSigning)' == ''">false</EnableCodeSigning>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<BindPath Include="$(MainPublishDirectory)">
			<BindName>MainPublish</BindName>
		</BindPath>

		<BindPath Include="$(WinPeClientPublishDirectory)">
			<BindName>WinPeClientPublish</BindName>
		</BindPath>

		<BindPath Include="$(ServicePublishDirectory)">
			<BindName>ServicePublish</BindName>
		</BindPath>
	</ItemGroup>

	<Target Name="PublishApplicationsForInstaller" BeforeTargets="BeforeBuild">
		<RemoveDir
			Directories="$(MainPublishDirectory);$(ServicePublishDirectory);$(WinPeClientPublishDirectory)" />

		<MSBuild
			Projects="$(MainApplicationProject)"
			Targets="Restore;Publish"
			Properties="Configuration=Release;PublishProfile=FolderProfile;RuntimeIdentifier=win-x64;PublishDir=$(MainPublishDirectory);EnableCodeSigning=$(EnableCodeSigning);BuildTimestampUtc=$(BuildTimestampUtc);BuildVersion=$(BuildVersion);BuildInformationalVersion=$(BuildInformationalVersion)" />

		<MSBuild
			Projects="$(WinPeClientProject)"
			Targets="Restore;Publish"
			Properties="Configuration=Release;PublishProfile=FolderProfile1;RuntimeIdentifier=win-x64;PublishDir=$(WinPeClientPublishDirectory);EnableCodeSigning=$(EnableCodeSigning);BuildTimestampUtc=$(BuildTimestampUtc);BuildVersion=$(BuildVersion);BuildInformationalVersion=$(BuildInformationalVersion)" />

		<MSBuild
			Projects="$(ServiceProject)"
			Targets="Restore;Publish"
			Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=false;PublishDir=$(ServicePublishDirectory);EnableCodeSigning=$(EnableCodeSigning);BuildTimestampUtc=$(BuildTimestampUtc);BuildVersion=$(BuildVersion);BuildInformationalVersion=$(BuildInformationalVersion)" />

		<ItemGroup>
			<WinPeClientPublishFiles Include="$(WinPeClientPublishDirectory)\**\*" />
		</ItemGroup>

		<Copy
			SourceFiles="@(WinPeClientPublishFiles)"
			DestinationFiles="@(WinPeClientPublishFiles->'$(ServicePublishDirectory)\WinPEClient\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true" />
	</Target>

	<Target
		Name="SignInstaller"
		AfterTargets="Build"
		Condition="'$(Configuration)' == 'Release' and '$(EnableCodeSigning)' == 'true'">

		<Exec
			Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Build\Sign-File.ps1&quot; -FilePath &quot;$(TargetPath)&quot; -CertificateThumbprint &quot;$(CodeSigningCertificateThumbprint)&quot;" />
	</Target>

</Project>
